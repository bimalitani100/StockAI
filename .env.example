# Browser-visible URL of the StockAI API. This is not a secret.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend configuration. Only the origin—not a path—is accepted by CORS.
STOCKAI_FRONTEND_ORIGIN=http://localhost:3000
STOCKAI_APP_NAME=StockAI API
STOCKAI_APP_VERSION=0.8.0

# Local PostgreSQL container and authentication settings.
STOCKAI_DATABASE_URL=postgresql+psycopg://stockai:stockai@localhost:5433/stockai
STOCKAI_JWT_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
STOCKAI_ACCESS_TOKEN_MINUTES=60
STOCKAI_SECURE_COOKIES=false
